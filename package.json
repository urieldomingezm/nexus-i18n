{
  "name": "nexus-i18n",
  "version": "0.0.0",
  "private": true,
  "description": "Tiny i18n core for the NEXUS libraries: nested keys, interpolation, plurals via Intl, fallback and Intl formatters. Dependency-free, no DOM.",
  "license": "MIT",
  "author": "Angel Uriel Domínguez Medina (DevMedina) (https://devmedina.is-a.dev/)",
  "homepage": "https://github.com/urieldomingezm/nexus-i18n#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/urieldomingezm/nexus-i18n.git"
  },
  "bugs": "https://github.com/urieldomingezm/nexus-i18n/issues",
  "type": "module",
  "main": "./dist/nexus-i18n.cjs",
  "module": "./dist/nexus-i18n.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/nexus-i18n.js" },
      "require": { "types": "./dist/index.d.ts", "default": "./dist/nexus-i18n.cjs" }
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
