{
  "name": "nexus-i18n",
  "version": "0.1.0",
  "description": "Tiny i18n core for the NEXUS libraries: nested keys, interpolation, plurals via Intl, fallback and Intl formatters. Dependency-free, no DOM.",
  "keywords": [
    "i18n",
    "internationalization",
    "localization",
    "translation",
    "plurals",
    "intl",
    "typescript",
    "zero-dependencies",
    "nexus"
  ],
  "license": "MIT",
  "author": "Angel Uriel Domínguez Medina (DevMedina) (https://devmedina.is-a.dev/)",
  "homepage": "https://github.com/urieldomingezm/nexus-i18n#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/urieldomingezm/nexus-i18n.git"
  },
  "bugs": "https://github.com/urieldomingezm/nexus-i18n/issues",
  "type": "module",
  "main": "./dist/nexus-i18n.cjs",
  "module": "./dist/nexus-i18n.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/nexus-i18n.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/nexus-i18n.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
